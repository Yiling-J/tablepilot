{
  "name": "recipes",
  "description": "table of creative recipes",
  "columns": [
    {
      "name": "Name",
      "description": "creative and engaging recipe name that aligns with the cuisine. Avoid simple, formulaic names like combining ingredient names or using a straightforward 'cuisine + ingredient' format. Instead, aim for something unique and appealing, such as 'Tropical Bomber,' that captures the essence and intrigue of the dish.",
      "type": "string",
      "fill_mode": "ai",
      "context_length": 5
    },
    {
      "name": "Name Reason",
      "description": "why you pick this creative and attractive name for the recipe",
      "type": "string",
      "fill_mode": "ai"
    },
    {
      "name": "Must Have Ingredient",
      "description": "the ingredient recipe must include",
      "type": "string",
      "fill_mode": "pick",
      "source_type": "dataset",
      "source_id": "ingredients",
      "random": true,
      "replacement": false
    },
    {
      "name": "Ingredients",
      "description": "list of ingredients",
      "type": "array",
      "fill_mode": "ai"
    },
    {
      "name": "Instructions",
      "description": "list of steps for this recipe, try as detailed as possible for beginners",
      "type": "array",
      "fill_mode": "ai"
    },
    {
      "name": "Cooking Time",
      "description": "time required to cook the recipe (minutes)",
      "type": "integer",
      "fill_mode": "ai"
    },
    {
      "name": "Cuisine",
      "description": "type of cuisine",
      "type": "string",
      "fill_mode": "pick",
      "source_type": "options",
      "options": [
        "Italian",
        "Chinese",
        "Mexican",
        "Indian",
        "Japanese",
        "Thai",
        "French",
        "Spanish"
      ],
      "random": true,
      "replacement": false
    },
    {
      "name": "Meal",
      "description": "meal of the recipe",
      "type": "string",
      "fill_mode": "pick",
      "source_type": "options",
      "options": ["Dinner", "Lunch", "Desserts", "Appetizers"],
      "random": true,
      "replacement": true
    },
    {
      "name": "Difficulty Level",
      "description": "difficulty level of the recipe (1-5)",
      "type": "integer",
      "fill_mode": "ai"
    }
  ]
}
