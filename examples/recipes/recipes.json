{
  "name": "recipes",
  "description": "table of recipes",
  "columns": [
    {
      "name": "Name",
      "description": "recipe name",
      "type": "string",
      "fill_mode": "ai",
      "context_length": 5
    },
    {
      "name": "Ing1",
      "description": "the first ingredient recipe must include",
      "type": "string",
      "fill_mode": "pick",
      "source_type": "dataset",
      "source_id": "ings",
      "random": true,
      "replacement": false
    },
    {
      "name": "Ing2",
      "description": "the second ingredient recipe must include",
      "type": "string",
      "fill_mode": "pick",
      "source_type": "dataset",
      "source_id": "ings",
      "random": true,
      "replacement": false
    },
    {
      "name": "Ingredients",
      "description": "list of ingredients",
      "type": "array",
      "fill_mode": "ai"
    },
    {
      "name": "Cooking Time",
      "description": "time required to cook the recipe (minutes)",
      "type": "integer",
      "fill_mode": "ai"
    },
    {
      "name": "Meal",
      "description": "meal of the recipe",
      "type": "string",
      "fill_mode": "pick",
      "source_type": "options",
      "options": [
        "Dinner",
        "Breakfast",
        "Lunch",
        "Desserts",
        "Appetizers",
        "Drinks"
      ],
      "random": true,
      "replacement": true
    },
    {
      "name": "Difficulty Level",
      "description": "difficulty level of the recipe (1-5)",
      "type": "integer",
      "fill_mode": "ai"
    },
    {}
  ]
}
